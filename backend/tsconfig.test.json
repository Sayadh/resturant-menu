{
  // Typecheck for the unit tests. They run on Node's built-in test runner with
  // --experimental-strip-types, which requires explicit ".ts" import
  // extensions — allowed here, never in the build config.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["test/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
